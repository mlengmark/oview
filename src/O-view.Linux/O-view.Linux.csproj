<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0008 slice 8 (OVI-397): this is now the first executable in this project.
         Avalonia is this skin's own UI-toolkit choice (ADR-0007/0008 name no UI framework
         above this project, exactly as UseWPF was O-view.Tray's own choice in slice 3) —
         why this slice is a board merge regardless of line count (dependencies, packaging
         size). Tmds.DBus.Protocol is D6's own session-bus probe dependency, not a UI
         framework. Still no P/Invoke, no OS-conditional branching: everything genuinely
         Linux-specific here (the D-Bus probe, XDG autostart) is its own adapter, not a
         runtime OS check. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OView.Linux</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="O-view.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\O-view.Core\O-view.Core.csproj" />
    <ProjectReference Include="..\O-view.App\O-view.App.csproj" />
  </ItemGroup>

</Project>
