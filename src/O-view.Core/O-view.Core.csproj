<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-neutral by design: no Win32, no System.Drawing, no Microsoft.Win32,
         no OS-conditional branching, no user-facing display strings (ADR-0001).
         Intended enforcement: CI should be able to build and test this project
         on a non-Windows runner. No CI exists in this repository yet, so no
         such run has ever happened (ADR-0003, CLAUDE.md). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OView.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- First third-party runtime dependency in this repository, authorised by the board
         2026-09-28 for the usage ledger only (ADR-0006 board question C). Not a general
         appetite for dependencies. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
