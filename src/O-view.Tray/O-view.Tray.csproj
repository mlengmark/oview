<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: this skin owns every Windows-specific presentation fact, including
         the NotifyIcon.Text 127-character cap (ADR-0001, ADR-0002). Only the layers
         genuinely different per OS live here — not a shared implementation. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OView.Tray</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ADR-0008 slice 3 (OVI-360): this is now the first executable in the repo.
         UseWPF is the skin's own framework choice (ADR-0007/0008 name no UI framework
         anywhere above this project) and is why this slice is a board merge. -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="O-view.Tray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\O-view.Core\O-view.Core.csproj" />
    <ProjectReference Include="..\O-view.App\O-view.App.csproj" />
  </ItemGroup>

</Project>
